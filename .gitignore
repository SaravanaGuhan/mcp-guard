# ephemeral venvs created for Python targets
.mcpguard-venv/

# dependency trees installed into fixtures during dynamic tests
tests/fixtures/**/node_modules/
# Build output generated by dynamic test runs. Scoped to ts-server, which is
# the only fixture with a build script: a blanket tests/fixtures/**/dist/ rule
# silently excluded always-error-live/dist/index.js, that fixture's ONLY source
# file, so a fresh clone could not launch it and the golden test failed.
tests/fixtures/ts-server/dist/
tests/fixtures/**/package-lock.json

# The generic dist/ rule above also matches fixture directories. always-error-live
# ships its server AT dist/index.js -- that is authored source, not build output --
# so it is un-ignored explicitly. Without this a fresh clone gets a fixture whose
# package.json main points at a file that is not there, and the golden test fails.
!tests/fixtures/always-error-live/dist/
!tests/fixtures/always-error-live/dist/index.js
