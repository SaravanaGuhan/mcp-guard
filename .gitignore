# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
build/
dist/
.eggs/

# Virtualenvs
.venv/
venv/
env/
ENV/

# Ephemeral venvs MCP Guard creates for Python targets. Named here as well as
# being written outside the target tree, belt and braces.
.mcpguard-venv/

# Test and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.tox/

# Tool caches. MCP Guard's own caches live under ~/.cache/mcp-guard, not here,
# but MCPGUARD_STATIC_CACHE and MCPGUARD_CACHE can point anywhere.
.cache/
.ruff_cache/
.mypy_cache/
mcp-guard-cache/

# Scan output written to the working directory
mcp_security_scan_*.json
mcp_guard_*/

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Secrets. Nothing here should ever be committed.
*.key
*.pem
*.p12
*.pfx
.env
.env.*
credentials.json
secrets.json

# Fixture dependency trees, installed by dynamic tests rather than authored.
# A generated package-lock.json also changes what the dependency stage resolves,
# so it stays out: on this machine it turned 4 packages into 18 while CI saw 4.
tests/fixtures/**/node_modules/
tests/fixtures/**/package-lock.json

# Build output produced by the ts-server fixture's build script. Scoped to that
# fixture on purpose: a blanket tests/fixtures/**/dist/ rule silently excluded
# always-error-live/dist/index.js, which is that fixture's ONLY source file, so
# a fresh clone could not launch it and the golden test failed.
tests/fixtures/ts-server/dist/

# The generic dist/ rule above also matches fixture directories. always-error-live
# ships its server AT dist/index.js, which is authored source rather than build
# output, so it is un-ignored explicitly.
!tests/fixtures/always-error-live/dist/
!tests/fixtures/always-error-live/dist/index.js
